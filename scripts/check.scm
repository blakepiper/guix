(use-modules (gnu) (gnu home) (gnu home services) (gnu services) (guix packages)
             (guix download) (guix base16) (guix build-system trivial) (guix gexp)
             (srfi srfi-1) (json)
             ((gnu packages linux) #:prefix libre:)
             ((nongnu packages linux) #:prefix nongnu:)
             (gnu services desktop) (gnu services xorg)
             (workstation system base)
             (workstation packages browser)
             (workstation firefox-release)
             (workstation packages oxwm) (workstation packages codex))

(define system (primitive-load "hosts/t490/system.scm"))
(define home (primitive-load "hosts/t490/home.scm"))
;; Check both checkout mode and store-import mode: a flat local-file silently
;; turns an executable script into a non-executable store item.
(let* ((service (find (lambda (service)
                        (eq? (service-type-name (service-kind service)) 'editor-launcher))
                      (home-environment-services home)))
       (entry (and service (assoc ".local/bin/nvimide" (service-value service))))
       (file (and entry (cadr entry))))
  (unless (and (local-file? file) (local-file-recursive? file)
               (string-suffix? "/home/przvl/bin/nvimide" (local-file-file file))
               (not (zero? (logand #o111 (stat:perms (stat (local-file-file file))))))
               (any (lambda (entry)
                      (string=? "neovim" (package-name (if (pair? entry) (car entry) entry))))
                    (home-environment-packages home)))
    (error "nvimide must be deployed executable with Neovim in the Home profile")))
(primitive-load "scripts/check-codex-release.scm")
(primitive-load "scripts/check-firefox-release.scm")
(define release codex-release)
(define source (package-source codex))
(unless (and (eq? (package-build-system codex) trivial-build-system)
             (string=? (package-name codex) "codex")
             (string=? (package-version codex) (assoc-ref release "version"))
             (origin? source)
             (eq? (origin-method source) url-fetch)
             (string=? (origin-uri source) (assoc-ref release "url"))
             (string=? (origin-uri source)
                       (string-append "https://github.com/openai/codex/releases/download/"
                                      "rust-v" (package-version codex)
                                      "/codex-package-x86_64-unknown-linux-musl.tar.gz"))
             (string=? (bytevector->base16-string (content-hash-value (origin-hash source)))
                       (assoc-ref release "sha256"))
             (equal? (package-supported-systems codex) '("x86_64-linux"))
             (equal? (sort (map car (package-native-inputs codex)) string<?)
                     '("gzip" "patchelf" "python" "runtime-check" "tar"))
             (equal? (sort (map (lambda (input) (package-name (cadr input)))
                               (package-inputs codex)) string<?)
                     '("bash-minimal" "glibc" "ncurses-with-tinfo"))
             (memq codex (home-environment-packages home)))
  (error "Codex must use the complete resolved official runtime and its Guix relocation inputs"))
(unless (and (memq firefox-blix (home-environment-packages home))
             (eq? (package-build-system firefox-blix) trivial-build-system)
             (not (package-source firefox-blix))
             (let ((input (cadr (assoc "firefox" (package-inputs firefox-blix)))))
               (and (cached-firefox? input)
                    (string-prefix? "/gnu/store/" (cached-firefox-path input))
                    (string-suffix? (string-append "-firefox-" (package-version firefox-blix))
                                    (cached-firefox-path input))))
             (not (any (lambda (entry)
                         (string=? (package-name (if (pair? entry) (car entry) entry))
                                   "librewolf"))
                       (home-environment-packages home))))
  (error "Home must use the Blix policy package around the channel's Firefox"))
(let* ((input (cadr (assoc "policies" (package-inputs firefox-blix))))
       (policies (assoc-ref (call-with-input-file (local-file-file input) json->scm)
                            "policies"))
       (extensions (assoc-ref policies "ExtensionSettings")))
  (unless (and (equal? "strict" (assoc-ref (assoc-ref policies "EnableTrackingProtection") "Category"))
               (eq? #t (assoc-ref (assoc-ref (assoc-ref policies "Preferences")
                                            "privacy.globalprivacycontrol.enabled") "Value"))
               (equal? "blocked" (assoc-ref (assoc-ref (assoc-ref policies "AIControls") "Default") "Value"))
               (= 3 (length extensions))
               (every (lambda (id)
                        (let ((extension (assoc-ref extensions id)))
                          (and (equal? "force_installed" (assoc-ref extension "installation_mode"))
                               (eq? #t (assoc-ref extension "private_browsing")))))
                      '("uBlock0@raymondhill.net" "addon@darkreader.org"
                        "enhancerforyoutube@maximerf.addons.mozilla.org")))
    (error "Blix Firefox privacy policies/extensions must be preserved")))
(unless (string=? (operating-system-host-name system) "t490")
  (error "Unexpected hostname"))
;; Console startx must retain its root-managed socket and PAM screen locker.
(for-each
 (lambda (kind)
   (unless (any (lambda (service) (eq? (service-kind service) kind))
                (operating-system-services system))
     (error "Missing console X11 service" (service-type-name kind))))
 (list startx-command-service-type x11-socket-directory-service-type
       screen-locker-service-type elogind-service-type))
(unless (any (lambda (service)
               (eq? (service-type-name (service-kind service))
                    'workstation-x11-socket-permissions))
             (operating-system-services system))
  (error "Missing activation repair for existing X11 socket ownership"))
(for-each
 (lambda (name)
   (unless (any (lambda (entry)
                  (string=? (package-name (if (pair? entry) (car entry) entry))
                            name))
                (home-environment-packages home))
     (error "Missing X11 session package in Home" name)))
 '("oxwm-source" "st" "openssh" "fastfetch-minimal" "blesh" "firefox-blix"
   "xsetroot" "xset" "xrandr" "picom" "xss-lock" "i3lock"
   "alpinews-clipwatch" "eudev" "elogind"))
(let* ((files (find (lambda (service)
                      (eq? (service-type-name (service-kind service))
                           'workstation-files))
                    (home-environment-services home)))
       (entry (and files (assoc ".xinitrc" (service-value files))))
       (source (and entry (cadr entry))))
  (unless (and source (local-file? source)
               (local-file-recursive? source)
               (string-suffix? "/home/przvl/xinitrc" (local-file-file source))
               (not (zero? (logand #o111 (stat:perms (stat (local-file-file source)))))))
    (error "Home must deploy the executable repository xinitrc"))
  (when (assoc ".local/bin/st-bash" (service-value files))
    (error "The terminal must not depend on the obsolete st-bash wrapper"))
  (for-each
   (lambda (entry)
     (when (string-prefix? ".local/bin/" (car entry))
       (let ((source (cadr entry)))
         (unless (and (local-file? source) (local-file-recursive? source)
                      (not (zero? (logand #o111
                                         (stat:perms (stat (local-file-file source)))))))
           (error "Home helpers must retain executable mode in the store" (car entry))))))
   (service-value files)))
;; Bash comes from home-bash-service-type's profile extension, not the explicit
;; home-environment packages. Check the resulting profile, including extensions.
(let ((profile (service-value
                (fold-services (home-environment-services home)
                               #:target-type home-profile-service-type))))
  (unless (any (lambda (entry)
                 (string=? (package-name (if (pair? entry) (car entry) entry))
                           "bash"))
               profile)
    (error "The terminal requires interactive Bash in the Home profile")))
(unless (and (eq? (operating-system-kernel system) nongnu:linux)
             (equal? (operating-system-firmware system)
                     (cons nongnu:iwlwifi-firmware %base-firmware)))
  (error "T490 must use the explicit Linux and Intel Wi-Fi exception"))
(unless (and (eq? (operating-system-kernel base-operating-system)
                  libre:linux-libre)
             (equal? (operating-system-firmware base-operating-system)
                     %base-firmware))
  (error "Shared defaults must retain Linux-libre and free firmware"))
;; Folding catches missing or duplicate service dependencies, not just syntax.
(fold-services (operating-system-services system))
(fold-services (home-environment-services home)
               #:target-type home-service-type)
(for-each (lambda (entry)
            (let ((package (if (pair? entry) (car entry) entry)))
              (format #t "~a@~a\n" (package-name package) (package-version package))))
          (cons* oxwm-source codex (home-environment-packages home)))
(display "T490 system and Home configuration evaluated.\n")
