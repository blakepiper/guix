#!/bin/sh
set -eu
umask 077
dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"
# BusyBox mktemp requires trailing Xs; it does not support an XXXXXX.png suffix.
work=$(mktemp -d "$dir/.capture.XXXXXX")
file="$work/capture.png"
trap 'rm -rf "$work"' EXIT
case "${1:-}" in
    # Use a composited window for the outline on every mirrored output.
    # Freeze forces classic root drawing and prevents Picom from updating it.
    '') scrot --select --line 'mode=edge,width=3,color=#bbbbbb,opacity=255' "$file" ;;
    --full) scrot "$file" ;;
    --window) scrot --focused "$file" ;;
    *) echo 'Usage: screenshot-region [--full|--window]' >&2; exit 2 ;;
esac
[ -s "$file" ] || exit 1
final="$dir/$(date +%Y%m%d-%H%M%S)-${work##*.}.png"
[ ! -e "$final" ] && [ ! -L "$final" ] || exit 1
mv "$file" "$final"
xclip -selection clipboard -t image/png -i "$final"
