#!/bin/sh
# Apply options to physical slave keyboards only; never change the core map.
set -eu
[ -n "${DISPLAY:-}" ] || exit 0
config=${XDG_CONFIG_HOME:-$HOME/.config}/workstation/keyboard.conf
# shellcheck disable=SC1090
[ ! -r "$config" ] || . "$config"
[ -n "${WORKSTATION_SWAP_KEYBOARD_USB_ID:-}" ] || exit 0
xinput list --short | sed -n '/slave  keyboard/s/.*id=\([0-9]*\).*/\1/p' |
while IFS= read -r device; do
    product=$(xinput list-props "$device" 2>/dev/null |
        sed -n 's/.*Device Product ID ([0-9]*):[[:space:]]*//p') || continue
    [ "$product" = "$WORKSTATION_SWAP_KEYBOARD_USB_ID" ] || continue
    setxkbmap -device "$device" -option '' -option altwin:swap_alt_win
done
